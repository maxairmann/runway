# Optional. Without these, Runway runs fully on-device (your plan + the demo).
# With them, you can sign in with your email and use the same plan on your phone and laptop.
# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Set to true on a public demo deploy (for recruiters) so first-time
# visitors land in the sample household instead of the start screen.
VITE_START_IN_DEMO=false

# Server only (Vercel → Settings → Environment Variables). Used by api/invite.js.
# Never prefix the service key with VITE_, or it would be shipped to every browser.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=you@example.com
